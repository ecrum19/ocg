{
  "name": "ontology-companion-generator",
  "version": "1.1.1",
  "description": "Generate customizable GitHub Pages companion sites for semantic ontologies.",
  "keywords": [
    "ontology",
    "vocabulary",
    "rdf",
    "semantic-web",
    "github-pages",
    "shacl",
    "shex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecrum19/ocg.git"
  },
  "homepage": "https://github.com/ecrum19/ocg#readme",
  "bugs": {
    "url": "https://github.com/ecrum19/ocg/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "ocg": "bin/ocg.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "templates/",
    "source/README-source-guide.txt",
    "source/branding/",
    ".github/workflows/publish-pages.yml",
    "ocg.config.schema.json"
  ],
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "clean": "node scripts/build-site.mjs --clean",
    "test": "node --test tests/build.test.mjs",
    "ocg:build": "node scripts/build-site.mjs",
    "ocg:check": "node scripts/build-site.mjs --check",
    "ocg:clean": "node scripts/build-site.mjs --clean",
    "ocg:dev": "node bin/ocg.mjs dev"
  },
  "dependencies": {
    "graphology": "0.25.4",
    "rdf-parse": "5.0.0",
    "sigma": "2.4.0"
  }
}
