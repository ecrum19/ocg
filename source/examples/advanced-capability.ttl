@prefix ecv: <https://example.org/ecv#> .
@prefix ex: <https://example.org/data/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:advancedCapability
  a ecv:OnlineCapability ;
  rdfs:label "Advanced Example Capability"@en ;
  ecv:hasRequirement ex:authRequirement, ex:agreementRequirement ;
  ecv:hasConstraint ex:throttleConstraint ;
  ecv:recommendedForAudience ecv:DeveloperAudience, ecv:PublisherAudience ;
  ecv:statusNote "Published as the advanced demonstration graph for the OCG template."@en .

ex:authRequirement
  a ecv:Requirement ;
  rdfs:label "Authentication Required"@en .

ex:agreementRequirement
  a ecv:Requirement ;
  rdfs:label "Terms Acceptance Required"@en .

ex:throttleConstraint
  a ecv:Constraint ;
  rdfs:label "Throttle Constraint"@en ;
  ecv:maxRequests "120"^^xsd:integer .
