    family-names: Crum
    affiliation: "IDLab, Ghent University - imec"
    email: elias.crum@ugent.be
repository-code: "https://github.com/ecrum19/ontology_companion_generator"
url: "https://ecrum19.github.io/ontology_companion_generator/"
license: MIT
version: 1.6.0
date-released: "2026-10-05"
keywords:
  - ontology
  - vocabulary
  - rdf
  - semantic web
  - linked data
  - documentation
  - github-pages
  - shacl
  - shex
