    family-names: Crum
    affiliation: "IDLab, Ghent University - imec"
    email: elias.crum@ugent.be
repository-code: "https://github.com/ecrum19/ocg"
url: "https://ecrum19.github.io/ocg/"
license: MIT
version: 1.4.0
date-released: "2026-09-01"
keywords:
  - ontology
  - vocabulary
  - rdf
  - semantic web
  - linked data
  - documentation
  - github-pages
  - shacl
  - shex
